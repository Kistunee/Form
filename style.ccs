* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body{
    font-family: Arial,sans-serif;
    background-color: black;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 10px;
}

.box{
    background-color:grey;
    border: 2px;
    border-radius:10px;
    padding:20px;
    width:100%;
}

.box h1{
    color:white;
    font-size:25px;
    margin-bottom:8px;
}

.box p{
    color:white;
    font-size:16px;
    margin-bottom:20px;
}

.form-grid{
    display:grid;

}

.form-group{
    display:flex;
    flex-direction:column;
    gap:5px;
}

label{
    font-size: 14px;
    color: red;

}

input[type="text"],
input[type="email"],
input[type="password"],
input[type="tel"] 
{
  width: 100%;
  padding: 10px 12px;
  border: 1px solid #3a3a4a;
  border-radius: 8px;
  background-color: #12121a;
  color: #fff;
  font-size: 14px;
}

.gender-options {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  margin-top: 4px;
}

.gender-options label {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

input[type="radio"] {
  accent-color: #a855f7;
}

.error-text {
  color: #f87171;
  font-size: 12px;
  min-height: 16px;
}

.message-box {
  padding: 10px;
  border-radius: 8px;
  font-size: 14px;
  margin-bottom: 16px;
  display: none;
}

.message-box.success {
  display: block;
  background-color: #14532d;
  color: #86efac;
}

.message-box.error {
  display: block;
  background-color: #450a0a;
  color: #fca5a5;
}

.btn-register,
.btn-login {
  width: 100%;
  padding: 12px;
  margin-top: 20px;
  border: none;
  border-radius: 8px;
  background-color: #a855f7;
  color: white;
  font-size: 16px;
  cursor: pointer;
}

.btn-register:hover,
.btn-login:hover {
  background-color: #9333ea;
}

.form-footer {
  text-align: center;
  margin-top: 16px;
  font-size: 14px;
  color: #9ca3af;
}

.form-footer a {
  color: #a855f7;
  text-decoration: none;
}

.form-footer a:hover {
  text-decoration: underline;
}